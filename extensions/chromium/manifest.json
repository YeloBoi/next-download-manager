{
  "manifest_version": 3,
  "name": "NDM — Next Download Manager",
  "description": "Send direct file links to your local NDM desktop app, only when you choose.",
  "version": "0.1.5",
  "minimum_chrome_version": "116",
  "default_locale": "en",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "NDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "version_name": "0.1.0-alpha.6",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
