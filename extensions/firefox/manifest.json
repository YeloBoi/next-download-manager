{
  "manifest_version": 3,
  "name": "NDM — Next Download Manager",
  "description": "Send direct file links to your local NDM desktop app, only when you choose.",
  "version": "0.1.9",
  "default_locale": "en",
  "host_permissions": ["https://github.com/*", "https://release-assets.githubusercontent.com/*"],
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "NDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ndm@yeloboi.github.io",
      "update_url": "https://github.com/YeloBoi/next-download-manager/releases/latest/download/firefox-updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
