    "bundle": "cd apps/desktop && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "lucide": "^0.577.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.5",
    "typescript": "~5.9.3",
    "vite": "8.3.8"
  }
}
